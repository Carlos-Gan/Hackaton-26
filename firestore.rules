rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isMember(companyId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/empresas/$(companyId)/miembros/$(request.auth.uid));
    }

    function isOwner(companyId) {
      return isMember(companyId)
        && get(/databases/$(database)/documents/empresas/$(companyId)/miembros/$(request.auth.uid)).data.rol == 'owner';
    }

    match /empresas/{companyId} {
      allow read: if true;
      allow create, update, delete: if isOwner(companyId);

      match /productos/{productId} {
        allow read: if isMember(companyId) || resource.data.activo == true;
        allow create, delete: if isOwner(companyId);

        function validCheckoutDecrease() {
          let reservationId = request.resource.data.get('ultimaReserva', '');
          let orderPath = /databases/$(database)/documents/empresas/$(companyId)/pedidos/$(reservationId);
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'ultimaReserva'])
            && resource.data.stock is number
            && request.resource.data.stock is number
            && request.resource.data.stock >= 0
            && request.resource.data.stock < resource.data.stock
            && reservationId is string
            && existsAfter(orderPath)
            && getAfter(orderPath).data.reservaId == reservationId
            && getAfter(orderPath).data.estado == 'Pendiente de pago'
            && getAfter(orderPath).data.cantidadesPorProducto.get(productId, 0) == resource.data.stock - request.resource.data.stock;
        }

        allow update: if isOwner(companyId) || validCheckoutDecrease();
      }

      match /ventasMostrador/{saleId} {
        function validSale() {
          let saleProduct = request.resource.data.productos[0];
          let quantity = saleProduct.cantidad;
          let productPath = /databases/$(database)/documents/empresas/$(companyId)/productos/$(saleProduct.productoId);
          return request.resource.data.keys().hasAll([
              'folio', 'tipo', 'cliente', 'productos', 'total', 'metodoPago',
              'estado', 'entrega', 'creadoEn', 'registradoPor'
            ])
            && request.resource.data.keys().hasOnly([
              'folio', 'tipo', 'cliente', 'productos', 'total', 'metodoPago',
              'estado', 'entrega', 'creadoEn', 'registradoPor'
            ])
            && request.resource.data.folio is string
            && request.resource.data.tipo == 'mostrador'
            && request.resource.data.cliente == 'Venta en mostrador'
            && request.resource.data.productos is list
            && request.resource.data.productos.size() == 1
            && saleProduct.keys().hasOnly(['productoId', 'nombre', 'precio', 'cantidad', 'personalizacion'])
            && saleProduct.productoId is string
            && saleProduct.nombre is string
            && saleProduct.precio is number
            && saleProduct.precio > 0
            && quantity is int
            && quantity > 0
            && request.resource.data.total is number
            && request.resource.data.total == saleProduct.precio * quantity
            && request.resource.data.metodoPago in ['Efectivo', 'Transferencia', 'Tarjeta']
            && request.resource.data.estado == 'Entregado'
            && request.resource.data.entrega is string
            && request.resource.data.creadoEn is timestamp
            && request.resource.data.registradoPor == request.auth.uid
            && exists(productPath)
            && get(productPath).data.stock is number
            && getAfter(productPath).data.stock == get(productPath).data.stock - quantity;
        }

        allow create: if isOwner(companyId) && validSale();
        allow read: if isMember(companyId);
        allow update, delete: if false;
      }

      match /pedidos/{orderId} {
        allow create: if request.resource.data.keys().hasAll([
            'cliente', 'productos', 'total', 'entrega', 'estado', 'creadoEn',
            'cantidadesPorProducto', 'reservaId'
          ])
          && request.resource.data.keys().hasOnly([
            'cliente', 'productos', 'total', 'entrega', 'estado', 'creadoEn',
            'cantidadesPorProducto', 'reservaId'
          ])
          && request.resource.data.cliente is string
          && request.resource.data.productos is list
          && request.resource.data.productos.size() > 0
          && request.resource.data.total is number
          && request.resource.data.total > 0
          && request.resource.data.entrega is string
          && request.resource.data.estado == 'Pendiente de pago'
          && request.resource.data.creadoEn is timestamp
          && request.resource.data.cantidadesPorProducto is map
          && request.resource.data.cantidadesPorProducto.size() > 0
          && request.resource.data.reservaId == orderId;

        allow read, update, delete: if isMember(companyId);
      }

      match /miembros/{memberId} {
        allow read: if request.auth != null && request.auth.uid == memberId;
        allow write: if false;
      }
    }
  }
}
